// Pinpoint — Prisma schema
// Stack: PostgreSQL (Neon or Supabase), Prisma Client.
// Conventions:
//   - Primary keys are cuid strings (non-guessable, safe in URLs).
//   - Enum values are lowercase so DB values match the API JSON exactly (no mapping layer).
//   - Every query in the API is scoped by userId; indexes below exist for the queries we actually run.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon/Supabase: pooled URL for the app, direct URL for migrations.
  // Set both in .env. If you use a single direct connection, set them to the same value.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Result of the AI check for a single key point (PRD FR-4.4).
/// Weights (1 / 0.5 / 0 / 0) live in code, not here — the AI never scores.
enum PointStatus {
  covered
  partial
  incorrect
  missing
}

/// Self-graded recall outcome (PRD FR-6.4).
enum RecallOutcome {
  green
  red
}

enum FileType {
  pdf
  image
}

/// Whether a topic's notes were uploaded by the student or generated by AI (PRD FR-2.2).
enum NotesSource {
  uploaded
  generated
}

// ---------------------------------------------------------------------------
// Account
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  /// Explain pass mark percentage (PRD FR-1.4, default 70).
  passMark     Int      @default(70)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  units        Unit[]
  topics       Topic[]
  places       Place[]
  recallRounds RecallRound[]
  exams        Exam[]
}

// ---------------------------------------------------------------------------
// Study material
// ---------------------------------------------------------------------------

model Unit {
  id        String   @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics Topic[]
  exams  Exam[]

  @@index([userId])
}

model Topic {
  id       String  @id @default(cuid())
  userId   String
  unitId   String?
  title    String
  /// Short notes summary shown on the topic screen.
  notes    String?
  /// Key points: [{ "id": 1, "text": "..." }, ...] — 5 to 8 items, stable numeric ids.
  /// Kept as JSON on purpose: points are rewritten wholesale on every re-extract,
  /// and flags / explanation results reference them by that numeric id.
  /// NOTE: no FK exists on Flag.keyPointId or Explanation.points — see those models.
  keyPoints Json    @default("[]")
  /// Cached 0-100 mastery, recomputed on explain submit and recall finish.
  /// Stored (not derived on read) because the dashboard lists every topic.
  mastery   Int     @default(0)
  notesSource NotesSource @default(generated)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Deleting a unit must not delete the student's topics: they fall back to a flat list.
  unit         Unit?         @relation(fields: [unitId], references: [id], onDelete: SetNull)
  files        TopicFile[]
  explanations Explanation[]
  flags        Flag[]

  @@index([userId])
  @@index([unitId])
}

model TopicFile {
  id         String   @id @default(cuid())
  topicId    String
  url        String
  /// Cloudinary public_id / storage key — required to delete the asset (PRD FR-3.6).
  storageKey String?
  type       FileType
  /// PDF page count, or 1 per image. Server enforces a total of 2 (PRD FR-3.2).
  pageCount  Int      @default(1)
  createdAt  DateTime @default(now())

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

/// One Explain attempt. Attempts are kept so progress across retries is visible (FR-4.8).
model Explanation {
  id          String   @id @default(cuid())
  topicId     String
  transcript  String
  durationSec Int
  /// Computed in server code: round(sum(weights) / points * 100). Never from the AI.
  score       Int
  /// Per-point results: [{ "id": 1, "status": "covered", "feedback": "..." }, ...]
  points      Json
  /// Ids of the points to retry next: [2, 3]
  nextFocus   Json     @default("[]")
  createdAt   DateTime @default(now())

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId, createdAt])
}

// ---------------------------------------------------------------------------
// Memory palace
// ---------------------------------------------------------------------------

model Place {
  id         String   @id @default(cuid())
  userId     String
  name       String
  imageUrl   String
  storageKey String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  flags        Flag[]
  recallRounds RecallRound[]

  @@index([userId])
}

model Flag {
  id    String @id @default(cuid())
  placeId String
  /// Optional link to a topic. SetNull on topic delete: the flag survives as a free note,
  /// so deleting study material never destroys the student's palace.
  topicId String?
  /// Optional link to a key point *id inside Topic.keyPoints JSON* — deliberately not a
  /// foreign key (the points are JSON). Validate it in the flag service, and re-map or
  /// null it when a topic is re-extracted.
  keyPointId Int?

  /// Position as percentages of the image (0-100) so flags stay aligned on any screen (FR-5.6).
  x     Float
  y     Float
  title String
  note  String?
  emoji String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  place         Place          @relation(fields: [placeId], references: [id], onDelete: Cascade)
  topic         Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)
  recallResults RecallResult[]

  @@index([placeId])
  @@index([topicId])
}

// ---------------------------------------------------------------------------
// Recall
// ---------------------------------------------------------------------------

model RecallRound {
  id           String    @id @default(cuid())
  userId       String
  placeId      String
  timeLimitSec Int
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  /// Written when the round finishes, so the dashboard's "latest round mostly green"
  /// check (FR-2.4) is one row read instead of an aggregate over results.
  greenCount   Int       @default(0)
  redCount     Int       @default(0)

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  place   Place          @relation(fields: [placeId], references: [id], onDelete: Cascade)
  results RecallResult[]

  @@index([userId, startedAt])
  @@index([placeId])
}

model RecallResult {
  id           String        @id @default(cuid())
  roundId      String
  flagId       String
  outcome      RecallOutcome
  secondsTaken Float
  createdAt    DateTime      @default(now())

  round RecallRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  flag  Flag        @relation(fields: [flagId], references: [id], onDelete: Cascade)

  // One verdict per flag per round; a repeat reveal updates the existing row.
  @@unique([roundId, flagId])
  @@index([roundId])
  @@index([flagId])
}

// ---------------------------------------------------------------------------
// Exams
// ---------------------------------------------------------------------------

model Exam {
  id       String   @id @default(cuid())
  userId   String
  unitId   String?
  title    String
  examDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit Unit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([userId, examDate])
  @@index([unitId])
}