{
  "name": "@pinpoint/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "tsx --test test/auth.test.ts test/ownership.test.ts test/upload-validation.test.ts test/upload-tickets.test.ts test/topic-file-limits.test.ts test/socket-contract.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "worker": "tsx watch src/worker.ts",
    "worker:start": "node dist/src/worker.js"
  },
  "dependencies": {
    "@pinpoint/shared": "1.0.0",
    "@prisma/client": "^6.19.0",
    "@google/genai": "^1.27.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "redis": "^4.7.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.13.4",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.20.1",
    "prisma": "^6.19.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
