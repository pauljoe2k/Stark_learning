{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install --replace-registry-host=always",
  "buildCommand": "npm run build --workspace @pinpoint/shared && npm run build --workspace @pinpoint/web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
